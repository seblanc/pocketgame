CONFIG_IDF_TARGET="esp32s3"
# console on the board's USB-C port (USB Serial/JTAG), the port the test bench uses
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# two OTA app slots, ready for over-the-air updates
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# HTTPS to GitHub (release check and download): the public CA bundle; TLS buffers
# allocated as needed so the handshake fits next to Wi-Fi and the frame buffer
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y

# phones send long headers to the setup page
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=1024

# cap Wi-Fi TX power from the first frame: full-power bursts while joining can drop
# the USB serial link on this board
CONFIG_ESP_PHY_MAX_WIFI_TX_POWER=11
